# Конфигурация telnet-клиента для ТСД (Android 4.0.4)
#
# Это ПРИМЕР. Скопируйте файл в /sdcard/telnet.ini и укажите свои значения:
#   adb push telnet.ini.example /sdcard/telnet.ini
# Файл читается заново при каждом подключении — можно править на устройстве.
# Комментарии начинаются с # или ;. Пробелы в значениях сохраняются!
#
# Escape-последовательности: \e = ESC, \r = CR, \n = LF, \t = TAB, \xNN, \033

[server]
# адрес сервера складской системы и порт telnet
host=192.168.0.10
port=23
timeout=10
# подключаться сразу при запуске и восстанавливать связь при обрыве
auto_connect=1
auto_reconnect=1
reconnect_delay=5
# важно для ТСД: без nodelay символы копятся и «залипают»
nodelay=1
keepalive=1
# кодировки: cp866 / windows-1251 / koi8-r / utf-8
# на сервере автора подошла koi8-r; подбирается в приложении: меню > Кодировка
charset_recv=koi8-r
charset_send=koi8-r
terminal_type=VT100
# сервер присылает только LF без CR (типично для меню на Linux) — включаем автоперевод
lf_as_crlf=1
# что отправлять на Enter: CR, LF или CRLF
enter=CR

[auth]
# логин и пароль берутся отсюда и подставляются в ответ на приглашение сервера
login=user
password=change_me
# тексты приглашений, после которых отправляется ответ выше
prompt_login=login:
prompt_password=Password:
# произвольные пары «приглашение → ответ», если сервер спрашивает что-то ещё
# prompt1=Код склада:
# answer1=01
# ответ отправлять сразу после подключения (без ожидания приглашения)
send_on_connect=0
# пауза перед ответом, чтобы сервер успел включить чтение строки
delay_ms=300

[keys]
# Только исключения: всё остальное уходит на сервер как есть.
# Клавиша=строка либо DISABLE, чтобы заглушить клавишу.
# Имена клавиш: как в Android (KEYCODE_F1) или без префикса (F1), либо числовой код.
# Подобрать код клавиши ТСД: включите в приложении меню > Диагностика ввода и нажмите
# клавишу — на экране появится её имя и код, его и вписывайте сюда.
# F1 -> ESC O P, стрелки -> ESC [ A/B/C/D
#F1=\eOP
#F2=\eOQ
#VOLUME_UP=DISABLE
#VOLUME_DOWN=DISABLE
#BACKSPACE=\x08
#ENTER=CR

[scanner]
# keyboard — сканер работает как клавиатура (цифры + Enter); intent — приём штрихкода от iScan
keyboard=1
intent=0
# intent_auto=1 — слушать рассылки iScan, даже если intent=0 (0 — не слушать)
intent_auto=1
# Что включить в самом iScan (МЕНЮ > Настройки > Настройки сканирования > Дополнительно):
#   Режим передачи результата = Рассылка / Intent (Broadcast)
#   у iScan должна быть разрешена работа в фоне, иначе рассылка не дойдёт до приложения
# action iData и имя extra со штрихкодом
intent_action=android.intent.action.SCANRESULT
intent_extra=value
# можно перечислить несколько action через запятую — на случай смены прошивки:
#intent_action=android.intent.action.SCANRESULT,nlscan.action.SCANNER_RESULT,com.symbol.datawedge.api.RESULT_ACTION
# что дописать после штрихкода
suffix=CR

[screen]
# auto_size=1 — сетка символов считается по размеру экрана (для широких меню).
# Если сервер отдаёт строго 80x24, поставьте auto_size=0, cols=80, rows=24 —
# приложение подберёт шрифт так, чтобы всё влезло.
auto_size=1
cols=80
rows=24
# в режиме auto_size=1: сетка, которая обязана влезть.
# Меньше колонок — крупнее шрифт (40x12 обычно, 32x10 — крупнее, 48x16 — мельче)
min_cols=40
min_rows=12
font_size=12
max_font_size=20
scrollback=500
theme=dark
# встроенный моношрифт с кириллицей и рамками (DejaVu Sans Mono)
# 0 — системный моношрифт ТСД
builtin_font=1
# ascii — если шрифт ТСД не рисует псевдографику
box_drawing=unicode
bright_bold=1

[log]
# лог в файл — помогает разбирать проблемы прямо на терминале
enabled=0
data=0
file=/sdcard/telnet.log
